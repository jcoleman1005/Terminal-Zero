[gd_scene load_steps=2 format=3 uid="uid://terminal_view"]

; ── TerminalView scene ────────────────────────────────────────────────────────
;
; Owned by: Terminal Agent
; Milestone: 1 — Functional terminal
;
; Node structure:
;   TerminalView (PanelContainer)
;   └── VBox (VBoxContainer)
;       ├── ScrollContainer
;       │   └── OutputLabel (RichTextLabel)
;       ├── NewOutputBar (Label)
;       └── InputRow (HBoxContainer)
;           ├── PromptLabel (Label)
;           └── CommandLineEdit (LineEdit)

[ext_resource type="Script" path="res://scripts/ui/terminal/terminal_view.gd" id="1_tvscript"]

[node name="TerminalView" type="PanelContainer"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_tvscript")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 0

[node name="ScrollContainer" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
follow_focus = false

[node name="OutputLabel" type="RichTextLabel" parent="VBox/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
selection_enabled = true
text = ""

[node name="NewOutputBar" type="Label" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 3
text = "▼ NEW OUTPUT"
horizontal_alignment = 1
visible = false

[node name="InputRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="PromptLabel" type="Label" parent="VBox/InputRow"]
layout_mode = 2
text = "guest@osiris:~$ "

[node name="CommandLineEdit" type="LineEdit" parent="VBox/InputRow"]
layout_mode = 2
size_flags_horizontal = 3
flat = true
