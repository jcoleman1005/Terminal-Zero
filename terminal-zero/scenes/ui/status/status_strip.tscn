[node name="StatusStrip" type="PanelContainer"]
anchor_right = 1.0
layout_mode = 3
anchors_preset = 15
anchor_bottom = 0.0
custom_minimum_size = Vector2(0, 24)
size_flags_horizontal = 3
script = ExtResource("1_strip")
