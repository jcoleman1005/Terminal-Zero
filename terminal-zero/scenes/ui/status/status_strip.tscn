; status_strip.tscn
; StatusStrip — reusable scene for the six-slot OSIRIS telemetry bar.
;
; Owned by: Status Strip Agent
; This scene may be instanced by main_ui.tscn once integration merges.
;
; The root node carries status_strip.gd which builds all child slots
; procedurally in _ready(), so no sub-nodes are declared here.

[gd_scene load_steps=2 format=3 uid="uid://status_strip"]

